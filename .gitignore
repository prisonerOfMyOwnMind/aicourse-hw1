# Исключение: собранный APK в evidence/ коммитится намеренно — у проверяющего
# нет целевого телефона, и это его способ запустить сдачу.
!evidence/*.apk
*.ap_
*.dex

# local.properties содержит путь к SDK на конкретной машине.
# Сборка на чужой машине идёт через ANDROID_HOME — см. AGENTS.md, «Как запускать и проверять».
local.properties

